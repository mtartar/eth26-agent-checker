# Copy this file to .env and fill in the values you need.
# Everything below has a working default for local dev against fixtures --
# you only need to set the API keys when switching DATA_SOURCE to "live".

# "fixture" runs entirely offline against recorded responses in tests/fixtures/.
# "live" makes real calls to external APIs.
DATA_SOURCE=fixture

DATABASE_URL=sqlite:///./agent_checker.db

# Empty string means "use the in-memory cache" -- see app/cache.py.
REDIS_URL=

# Required when DATA_SOURCE=live -- get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Required when DATA_SOURCE=live -- get one at https://thegraph.com/studio/
THE_GRAPH_API_KEY=
THE_GRAPH_GATEWAY_URL=https://gateway.thegraph.com

# GRC-20 / Geo knowledge graph endpoint -- see README for details.
GRC20_API_ORIGIN=
GRC20_SPACE_ID=

LOG_LEVEL=INFO
